{
  "name": "codesymphony",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@codesymphony/chat-timeline-core --filter=@codesymphony/runtime --filter=@codesymphony/web",
    "dev:web": "turbo run dev --parallel --filter=@codesymphony/chat-timeline-core --filter=@codesymphony/web",
    "dev:runtime": "turbo run dev --parallel --filter=@codesymphony/chat-timeline-core --filter=@codesymphony/runtime",
    "dev:desktop": "bun run --filter @codesymphony/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "knip": "knip -c knip.ts",
    "db:generate": "bun run --filter @codesymphony/runtime prisma:generate",
    "db:migrate": "bun run --filter @codesymphony/runtime prisma:migrate",
    "db:seed": "DATABASE_URL=\"file:./dev.db\" bun run --filter @codesymphony/runtime prisma:seed",
    "run": "turbo run build --filter=@codesymphony/runtime --filter=@codesymphony/web && WEB_DIST_PATH=../web/dist NODE_ENV=production PRISMA_SCHEMA_PATH=./prisma/schema.prisma bun run --filter @codesymphony/runtime start",
    "run:web": "bun run --filter @codesymphony/web preview",
    "run:runtime": "bun run --filter @codesymphony/runtime start",
    "instant-open:metrics:collect": "bun run --filter @codesymphony/runtime startup:metrics:collect",
    "instant-open:metrics:reset": "bun run --filter @codesymphony/runtime startup:metrics:reset",
    "instant-open:bundle:measure": "bun run --filter @codesymphony/web measure:workspace-bundle"
  },
  "devDependencies": {
    "knip": "^6.3.1",
    "turbo": "^2.8.8",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1"
  }
}
